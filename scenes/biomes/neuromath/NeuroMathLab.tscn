npc_name = "AXION-7 (Guardián Lógico)"
dialogue_lines = Array[String](["¡Bienvenido al Observatorio Cuántico! El núcleo del Nexo aquí se alimenta de dos fuerzas: la Lógica Proposicional (compuertas AND, OR, XOR) y el Razonamiento Cuantitativo.", "Recuerda: una compuerta AND solo emite energía (1) si TODAS sus entradas son 1. Una compuerta OR emite 1 si AL MENOS UNA entrada es 1. Y en ecuaciones de caudal, la entrada total siempre debe igualar la salida.", "Supera los 3 nodos de estabilización para recuperar el Fragmento Cian del Nexo. Si necesitas una pista, puedes invertir 10 XP."])

