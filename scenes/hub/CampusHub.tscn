script = ExtResource("9_ij48h")
npc_id = "bardo_guia"
npc_name = "Bardo Guía de Letras"
speaker_color = Color(1, 0.165, 0.522, 1)
dialogue_lines = Array[String](["¡Bienvenido al Cuadrante de las Letras y la Retórica!", "El portal hacia la Gran Biblioteca y Taller Tipográfico ha sido restaurado.", "En su interior, la Maestra Tipógrafa LIRA-9 custodia los códices ancestrales del lenguaje. ¡Demuestra tu dominio léxico y comprensión crítica!"])

[node name="GerenciaGuideNPC" type="Area2D" parent="Layer2_Entities/Guardians" instance=ExtResource("8_r650x")]
position = Vector2(608, 96)
collision_layer = 4
collision_mask = 2
script = ExtResource("9_ij48h")
npc_id = "gerencia_guia"
npc_name = "Mentora Ejecutiva Ágil"
speaker_color = Color(0.27450982, 0.50980395, 0.7058824, 1)
dialogue_lines = Array[String](["¡Saludos, estratega! Has llegado al Acceso Norte del Centro de Mando Ejecutivo.", "El portal hacia Gerencia+ está activo y sincronizado con la red organizacional.", "Adéntrate para liderar el tablero Kanban junto a KRONOS-4 y optimizar la asignación de talento sin sobrecargar tus equipos."])

[node name="ActivaTuIdeaGuideNPC" type="Area2D" parent="Layer2_Entities/Guardians" instance=ExtResource("8_r650x")]
position = Vector2(1088, 576)
collision_layer = 4
collision_mask = 2
script = ExtResource("9_ij48h")
npc_id = "activatuidea_guia"
npc_name = "Ingeniero Guía de Innovación"
speaker_color = Color(1, 0.54901963, 0, 1)
dialogue_lines = Array[String](["¡Bienvenido al Sector Sureste del Estudio de Innovación y Emprendimiento!", "La Fábrica de Innovación y Prototipado ActivaTuIdea ha encendido sus turbinas.", "Cruza el portal naranja para validar tu Lean Canvas y calibrar la línea de ensamblaje Tiny Factory junto al ingeniero FORGE-X."])

[node name="LatidoSocialGuideNPC" type="Area2D" parent="Layer2_Entities/Guardians" instance=ExtResource("8_r650x")]
position = Vector2(128, 576)
collision_layer = 4
collision_mask = 2
script = ExtResource("9_ij48h")
npc_id = "latidosocial_guia"
npc_name = "Guía Comunitario de Bienestar"
speaker_color = Color(0.29803923, 0.6862745, 0.3137255, 1)
dialogue_lines = Array[String](["¡Bienvenido al Sector Suroeste de la Aldea del Bienestar y Plaza Comunitaria!", "El portal hacia LatidoSocial se encuentra activo y conectado con el Pozo Central.", "Acompaña a la guardiana GAIA-4 para atender a los ciudadanos, fortalecer el tejido social y restaurar la armonía comunitaria."])

[node name="VoxCivitasGuideNPC" type="Area2D" parent="Layer2_Entities/Guardians" instance=ExtResource("8_r650x")]
position = Vector2(608, 640)
collision_layer = 4
collision_mask = 2
script = ExtResource("9_ij48h")
npc_id = "voxcivitas_guia"
npc_name = "Tribuno Guía de la Democracia"
speaker_color = Color(0.6117647, 0.15294118, 0.6901961, 1)
dialogue_lines = Array[String](["¡Saludos, ciudadano! Te encuentras frente al Acceso Sur del Ágora Cívica.", "El portal hacia VoxCivitas está abierto para la deliberación y participación ciudadana.", "Únete al tribuno CIVIS-1 en el podio Rostra para debatir con argumentos sólidos y defender la legitimidad democrática."])

